# No secrets belong in this file. The app reads real environment variables (it has no .env loader),
# so set these in your shell or your host's dashboard. All of them are optional locally.
PORT=3000
DB_FILE=server/data/internships.db
# Needed only for creating/updating/deleting internships. Leave empty to disable those routes.
# Generate a long random value, e.g.:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=
# Set to 1 when running behind a proxy such as Render so rate limiting sees the real client IP.
TRUST_PROXY=
